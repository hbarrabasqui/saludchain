# Copiar a .env y completar. NUNCA subir .env al repositorio.
# RPC de la testnet Sepolia (por ejemplo de Alchemy, Infura o un RPC publico)
SEPOLIA_RPC_URL=
# Clave de la API de Etherscan (para verificar contratos)
ETHERSCAN_API_KEY=
# Direccion publica que administra los roles
ADMIN_ADDRESS=
# Direccion publica del verificador (opcional; si se omite, es el admin)
VERIFICADOR_ADDRESS=
